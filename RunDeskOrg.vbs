
Option Explicit

' DeskOrg Launcher
' Credits: Nivesh Sahayak
' https://niveshsahayak.in | 8054009300

Dim fso, shell, appFolder, splashFile, logFile, command

Set fso = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")

appFolder = fso.GetParentFolderName(WScript.ScriptFullName)
splashFile = fso.BuildPath(appFolder, "DeskOrgSplash.ps1")
logFile = shell.ExpandEnvironmentStrings("%TEMP%") & "\DeskOrg.log"

If Not fso.FileExists(splashFile) Then
    MsgBox "DeskOrg splash screen was not found:" & vbCrLf & _
           splashFile, vbCritical, "DeskOrg"
    WScript.Quit 1
End If

command = "powershell.exe -NoLogo -NoProfile -STA " & _
          "-ExecutionPolicy AllSigned -WindowStyle Hidden " & _
          "-File """ & splashFile & """"

On Error Resume Next

shell.Run command, 0, False

If Err.Number <> 0 Then
    Dim errorText
    errorText = Err.Description

    Err.Clear

    Dim logFileHandle
    Set logFileHandle = fso.OpenTextFile(logFile, 8, True)
    logFileHandle.WriteLine Now & " | Launcher error: " & errorText
    logFileHandle.Close

    MsgBox "DeskOrg could not start." & vbCrLf & errorText, _
           vbCritical, "DeskOrg"
End If

On Error GoTo 0

Set shell = Nothing
Set fso = Nothing

